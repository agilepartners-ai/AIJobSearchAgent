# Copy to .env.local and fill in. Never commit a filled-in copy.

# ---------------------------------------------------------------------------
# AI — server-side only
# ---------------------------------------------------------------------------
# NOTE: these were previously NEXT_PUBLIC_GEMINI_API_KEY, which shipped the key
# to every visitor in the JS bundle. They must NOT be prefixed with NEXT_PUBLIC_.
#
# One paid key is the normal setup. GEMINI_API_KEYS (comma separated) is
# optional: if you ever need several, calls rotate across them.
GEMINI_API_KEYS=
GEMINI_API_KEY=
# Cheapest tier by default. Set to pin a model, e.g. gemini-3.5-flash-lite.
GEMINI_MODEL=gemini-flash-lite-latest
# Upper bound on one generation's output. A resume + cover letter is ~1-4k tokens.
GEMINI_MAX_OUTPUT_TOKENS=16384
# Optional: USD per million tokens (https://ai.google.dev/pricing). With the
# first two set, cost is recorded next to token counts in app.usage_daily.
GEMINI_PRICE_INPUT_PER_M=
GEMINI_PRICE_OUTPUT_PER_M=
GEMINI_PRICE_CACHED_PER_M=

# ---------------------------------------------------------------------------
# Per-account memory (RAG) — optional, server-side only
# ---------------------------------------------------------------------------
# NVIDIA embeddings (https://build.nvidia.com). Every resume and job description
# an account submits is embedded once and kept in that account's own store, then
# used to trim long resumes and to bring back relevant facts from older ones.
# This is where key rotation matters (free-tier embeddings are rate limited):
# comma separated, calls rotate across them. Leave empty to turn RAG off.
NVIDIA_API_KEYS=
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
# RAG_ENABLED=false            # force it off even with keys set
# Tuning (defaults are conservative; tune against real resumes):
# RAG_COMPRESS_ABOVE_CHARS=7000   resumes longer than this are compressed
# RAG_COMPRESS_TO_CHARS=5000
# RAG_SUPPLEMENT_CHUNKS=4         facts pulled from the account's other resumes
# RAG_MIN_SCORE=0.4               minimum similarity for a pulled fact
# RAG_TIMEOUT_MS=12000            retrieval never delays generation past this

# ---------------------------------------------------------------------------
# Load protection (per server instance)
# ---------------------------------------------------------------------------
# GEN_MAX_CONCURRENCY=6           generations running at once; extras queue
# GEN_QUEUE_WAIT_MS=25000         how long one waits before "busy, try again"

# ---------------------------------------------------------------------------
# LaTeX compilation — server-side only
# ---------------------------------------------------------------------------
# API key from https://texapi.ovh. Compiles generated LaTeX into PDFs.
# See docs/self-hosted-latex-compiler.md for the self-hosting alternative.
TEXAPI_KEY=

# ---------------------------------------------------------------------------
# Supabase — authentication only (the anon key is public by design)
# Project Settings -> API. Never put the service_role key here.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# PostgreSQL — all application data and stored documents (server-side, SECRET)
# See db/README.md. PG_SSL_CA is the CA certificate on ONE line, newlines as \n.
# ---------------------------------------------------------------------------
DATABASE_URL=
PG_SSL_CA=
PG_POOL_MAX=2
# 24+ random characters (openssl rand -base64 36). Signs document download links.
DOCUMENT_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# Job search
# ---------------------------------------------------------------------------
NEXT_PUBLIC_JSEARCH_API_KEY=
NEXT_PUBLIC_JSEARCH_API_HOST=

# ---------------------------------------------------------------------------
# Tavus (AI interview)
# ---------------------------------------------------------------------------
# Server-only (never NEXT_PUBLIC_): the key is read by /api/interview and never sent to browsers.
TAVUS_API_KEY=

# ---------------------------------------------------------------------------
# Limits. Every account may generate DAILY_GENERATION_LIMIT tailored sets per day (default 5).
# Addresses in ADMIN_EMAILS (comma-separated, server-side only) are unlimited. The address must be verified.
# ---------------------------------------------------------------------------
DAILY_GENERATION_LIMIT=5
ADMIN_EMAILS=

# Cloudflare deploys (local only, never commit). Use an account API token scoped to Workers Scripts, Hyperdrive,
# SSL and Certificates (edit) and the zone's Workers Routes / DNS / Zone Settings. Delete it when you are done.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ---------------------------------------------------------------------------
# Gmail job sync (docs/GMAIL_JOB_SYNC_SCOPE.md). Off unless every value is set. Server-side only.
# Mail text must never go to a model that trains on it or lets humans read it (so never the free Gemini tier).
# These values are needed on the VM and, for connect/status/callback, as Worker secrets.
# ---------------------------------------------------------------------------
GMAIL_SYNC_ENABLED=
GEMINI_PAID_TIER=
GMAIL_GOOGLE_CLIENT_ID=
GMAIL_GOOGLE_CLIENT_SECRET=
# https://<your-domain>/api/gmail/callback (must also be an authorised redirect URI on the Google OAuth client)
GMAIL_REDIRECT_URI=
# 32 random bytes, base64:   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GMAIL_TOKEN_KEY=
GMAIL_STATE_SECRET=
# Lets the daily timer call /api/gmail/sync-all on the VM. At least 16 characters.
GMAIL_CRON_SECRET=
# Model for the mail text. Default: Cloudflare Workers AI (free 10,000 neurons/day, no training on your content).
# Create CF_AI_TOKEN in the Cloudflare account that owns CF_AI_ACCOUNT_ID (template: Workers AI).
CF_AI_ACCOUNT_ID=
CF_AI_TOKEN=
# Optional: GMAIL_LLM=gemini (then also GEMINI_PAID_TIER=1 and a key on a billed Google project). Never the free Gemini tier.
GMAIL_LLM=
