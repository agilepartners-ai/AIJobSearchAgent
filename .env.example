# Copy to .env.local and fill in. Never commit a filled-in copy.

# ---------------------------------------------------------------------------
# AI — server-side only
# ---------------------------------------------------------------------------
# NOTE: these were previously NEXT_PUBLIC_GEMINI_API_KEY, which shipped the key
# to every visitor in the JS bundle. They must NOT be prefixed with NEXT_PUBLIC_.
#
# One paid key is the normal setup. GEMINI_API_KEYS (comma separated) is
# optional: if you ever need several, calls rotate across them.
GEMINI_API_KEYS=
GEMINI_API_KEY=
# Cheapest tier by default. Set to pin a model, e.g. gemini-3.5-flash-lite.
GEMINI_MODEL=gemini-flash-lite-latest
# Upper bound on one generation's output. A resume + cover letter is ~1-4k tokens.
GEMINI_MAX_OUTPUT_TOKENS=16384
# Optional: USD per million tokens (https://ai.google.dev/pricing). With the
# first two set, cost is recorded next to token counts in Firestore.
GEMINI_PRICE_INPUT_PER_M=
GEMINI_PRICE_OUTPUT_PER_M=
GEMINI_PRICE_CACHED_PER_M=

# ---------------------------------------------------------------------------
# Per-account memory (RAG) — optional, server-side only
# ---------------------------------------------------------------------------
# NVIDIA embeddings (https://build.nvidia.com). Every resume and job description
# an account submits is embedded once and kept in that account's own store, then
# used to trim long resumes and to bring back relevant facts from older ones.
# This is where key rotation matters (free-tier embeddings are rate limited):
# comma separated, calls rotate across them. Leave empty to turn RAG off.
NVIDIA_API_KEYS=
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
# RAG_ENABLED=false            # force it off even with keys set
# Tuning (defaults are conservative; tune against real resumes):
# RAG_COMPRESS_ABOVE_CHARS=7000   resumes longer than this are compressed
# RAG_COMPRESS_TO_CHARS=5000
# RAG_SUPPLEMENT_CHUNKS=4         facts pulled from the account's other resumes
# RAG_MIN_SCORE=0.4               minimum similarity for a pulled fact
# RAG_TIMEOUT_MS=12000            retrieval never delays generation past this

# ---------------------------------------------------------------------------
# Load protection (per server instance)
# ---------------------------------------------------------------------------
# GEN_MAX_CONCURRENCY=6           generations running at once; extras queue
# GEN_QUEUE_WAIT_MS=25000         how long one waits before "busy, try again"

# ---------------------------------------------------------------------------
# LaTeX compilation — server-side only
# ---------------------------------------------------------------------------
# API key from https://texapi.ovh. Compiles generated LaTeX into PDFs.
# See docs/self-hosted-latex-compiler.md for the self-hosting alternative.
TEXAPI_KEY=

# ---------------------------------------------------------------------------
# Firebase — client SDK (safe to expose; these identify the project, not you)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Firebase Admin — server-side only, these ARE secrets
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the whole key including the BEGIN/END lines, with literal \n escapes.
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Job search
# ---------------------------------------------------------------------------
NEXT_PUBLIC_JSEARCH_API_KEY=
NEXT_PUBLIC_JSEARCH_API_HOST=

# ---------------------------------------------------------------------------
# Tavus (AI interview)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TAVUS_API_KEY=
