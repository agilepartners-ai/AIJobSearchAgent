# Runtime environment of the generation service on the VM. Copy to ~/ajsa/ajsa.env (chmod 600). Never commit it.

# Same database, reached over the private docker network (no TLS needed inside the host).
DATABASE_URL=postgres://jobsearch_app:<password>@postgres:5432/jobsearch
PGSSLMODE=disable
PG_POOL_MAX=4

# Token verification (public values).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# MUST be identical to the Worker's DOCUMENT_SIGNING_SECRET: this service signs document links, and the Worker
# (which serves /api/documents/file) verifies them.
DOCUMENT_SIGNING_SECRET=<same value as the Worker secret>

# Generation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
NVIDIA_API_KEYS=
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
TEXAPI_KEY=

NODE_ENV=production

# Daily limit per account (default 5) and unlimited admin accounts (verified emails, comma-separated).
DAILY_GENERATION_LIMIT=5
ADMIN_EMAILS=you@example.com

# Gmail job sync (see .env.example and docs/GMAIL_JOB_SYNC_SCOPE.md). Leave GMAIL_SYNC_ENABLED empty to keep it off.
GMAIL_SYNC_ENABLED=
GEMINI_PAID_TIER=
GMAIL_GOOGLE_CLIENT_ID=
GMAIL_GOOGLE_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://agilepartners-ai.com/api/gmail/callback
GMAIL_TOKEN_KEY=
GMAIL_STATE_SECRET=
GMAIL_CRON_SECRET=
# Model for the mail text. Default: Gemini with the same GEMINI_API_KEY as résumés, which must be on a billed project
# (AI Studio shows "Paid") and then GEMINI_PAID_TIER=1. Never the free Gemini tier: it trains on prompts.
# Optional alternative: GMAIL_LLM=workers-ai with CF_AI_ACCOUNT_ID + CF_AI_TOKEN (Workers AI token, free 10,000 neurons/day).
GMAIL_LLM=
CF_AI_ACCOUNT_ID=
CF_AI_TOKEN=

# Forwarded-mail channel (no Google permission, no Google review): users forward job emails to jobs+<token>@INBOUND_DOMAIN.
# Cloudflare Email Routing hands them to the ajsa-inbound Worker, which posts them to this service.
# The Worker (web app) needs INBOUND_ENABLED and INBOUND_DOMAIN to show the address; only the VM and the ajsa-inbound Worker need INBOUND_SECRET.
INBOUND_ENABLED=
INBOUND_DOMAIN=aitoolsfordoctor.com
# 24+ random characters, the same value on the VM and in the ajsa-inbound Worker secret.
INBOUND_SECRET=
